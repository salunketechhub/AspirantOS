# ==============================================================================
# AspirantOS Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` or configure corresponding environment variables in
# your system or deployment environment.
#
# IMPORTANT: DO NOT commit actual secrets or credentials to source control.
# ==============================================================================

# Database Connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aspirantos
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Stateless Authentication (Step 2)
# CRITICAL: Must be at least 32 characters (256 bits) long for HMAC-SHA256
JWT_SECRET=replace-with-a-very-strong-secret-key-at-least-32-chars-long!
JWT_EXPIRATION=86400000

# Backend Application Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Frontend Configuration
FRONTEND_PORT=4200
API_BASE_URL=http://localhost:8080/api
